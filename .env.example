# DRS — Environment variables
# Is file ko copy karke .env banao aur REAL values bharo:
#   cp .env.example .env
# .env ko KABHI git me commit mat karo (ye .gitignore me hai).
# SEC-H5: neeche koi pre-filled secret NAHI hai — khaali values
# startup par fail hongi (config _required), taaki placeholder keys
# ke saath production kabhi start na ho.

# Flask / JWT — lambe random strings use karo:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Kam se kam 32 characters, placeholder values reject ho jati hain.
SECRET_KEY=
JWT_SECRET_KEY=

# Database (docker-compose ke liye) — password khaali mat chhodo.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=drsdb
DATABASE_HOST=timescaledb
DATABASE_PORT=5432

# Redis / Celery — REDIS_PASSWORD alphanumeric rakho (URL me jata
# hai). Yehi password redis requirepass aur broker URL dono me
# use hota hai; docker-compose fail-fast hai agar ye unset ho.
REDIS_HOST=redis
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://:YOUR-REDIS-PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:YOUR-REDIS-PASSWORD@redis:6379/0
# Rate limiter storage: prod me Redis DB 1 (Celery DB 0 se alag).
RATELIMIT_STORAGE_URI=redis://:YOUR-REDIS-PASSWORD@redis:6379/1

# Backend
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=500
TRACK_EVERY_N_FRAMES=2
# TRUST_PROXY=1 sirf tab jab nginx jaise single trusted proxy ke
# peeche chal raha ho (docker-compose me backend/worker ke liye
# pehle se set hai); direct deploy par ise set mat karo.
TRUST_PROXY=
