# DRS — Environment variables
# Is file ko copy karke .env banao aur REAL values bharo:
#   cp .env.example .env
# .env ko KABHI git me commit mat karo (ye .gitignore me hai).

# Flask / JWT — lambe random strings use karo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Database (docker-compose ke liye)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=drsdb
DATABASE_HOST=timescaledb
DATABASE_PORT=5432

# Redis / Celery
REDIS_HOST=redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Backend
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=500
TRACK_EVERY_N_FRAMES=2
